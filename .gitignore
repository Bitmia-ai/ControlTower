# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.test
# RedEye — entire control directory is local-only orchestration state,
# not source. Worktrees and instance claims are also runtime-only.
.redeye/
.active-claims.json
.worktrees/

# Claude Code local state
.claude/

# Superpowers — runtime brainstorm session output
.superpowers/

# Historical task specs and archived task descriptions — not part of the published source surface
docs/specs/
docs/tasks-archive/
docs/inbox-archive/
docs/changelog-archive/

# Debug artifacts from tests / Playwright — keep out of repo root
*.png
!.github/assets/*.png
!public/**/*.png
!app/icon*.png
!app/apple-icon*.png
test-results/
screenshots/
.playwright-mcp/
