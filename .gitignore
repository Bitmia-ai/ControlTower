# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.test
.redeye/digest.json
.redeye/gate-*
.worktrees/

# Per-project runtime — Control Tower manages these at runtime, don't ship them
.redeye/state.json
.redeye/session-*.jsonl
.redeye/session-*.pid
.redeye/status.md
.redeye/specs/
.redeye/tester-reports.md
.redeye/feedback.md
.redeye/changelog.md
.redeye/inbox.md
.redeye/backlog.md
.redeye/schedules.md
.redeye/config.md

# Claude Code local state
.claude/

# Debug artifacts from tests / Playwright — keep out of repo root
*.png
!.github/assets/*.png
!public/**/*.png
test-results/
screenshots/
.playwright-mcp/
