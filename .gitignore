# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.test
# RedEye — track the canonical project state (backlog, steering, inbox,
# state.json, etc.) so the repo is a self-contained record of how this
# project was built. Only exclude truly transient runtime artifacts:
# regenerated digests, lock files, session logs, pid files.
.redeye/digest.json
.redeye/gate-*
.redeye/session-*.jsonl
.redeye/session-*.pid
.redeye/*.log
.worktrees/

# Claude Code local state
.claude/

# Debug artifacts from tests / Playwright — keep out of repo root
*.png
!.github/assets/*.png
!public/**/*.png
test-results/
screenshots/
.playwright-mcp/
