# Control Tower — Runtime Environment Variables
# Copy this file to .env.local and set values as needed.
# None of these are required for a standard local setup — the defaults work out of the box.

# Path to the RedEye projects registry JSON file.
# This file lists the project paths Control Tower manages.
# Default: ~/.redeye/config.json
# REDEYE_CONFIG_PATH=

# Path to the RedEye plugin directory (used for resolving the claude plugin).
# Default: ~/redeye
# REDEYE_PLUGIN_DIR=

# Path to the Claude CLI binary.
# Must be on PATH or provide an absolute path.
# Default: claude
# CLAUDE_BIN=

# Set to "1" to allow project paths outside $HOME.
# Useful when running in a monorepo, CI, or Docker where project roots are
# outside the home directory.
# Default: unset (only paths under $HOME are allowed)
# ALLOW_OUTSIDE_HOME=

# The user's home directory. Normally set by the OS — do not override unless
# running in a container with a non-standard home directory.
# Default: (system-provided by OS)
# HOME=
